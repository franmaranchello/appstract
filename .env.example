# Optional separate clash app root URL. Public configuration, never a secret.
# Defaults: Appstract dev :5173 discovers :5186; preview :4173 discovers :4186.
# Restart Vite after changes. The clash app must allow cross-origin manifest fetches.
VITE_CLASH_APP_URL=

# Legacy fallback, used only when VITE_CLASH_APP_URL is empty:
# VITE_DEMO_APP_URL=
